{
  "name": "crypto-force",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm typecheck && pnpm lint && pnpm check:rules && pnpm check:exports && pnpm check:docs && pnpm format:check",
    "check:exports": "node scripts/check-exports.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:stlc": "node --test scripts/check-stlc-docs.test.mjs && node scripts/check-test-scope-ids.mjs && node scripts/check-stlc-docs.mjs",
    "check:rules": "node --test scripts/eslint-plugin-testware.test.mjs scripts/vitest-configs.test.mjs scripts/mock-boundaries.test.mjs scripts/app-boundaries.test.mjs scripts/check-docs.test.mjs",
    "test": "pnpm -r --no-bail --workspace-concurrency=1 --filter @crypto-force/shared --filter @crypto-force/web --filter @crypto-force/api test",
    "test:e2e": "pnpm --filter @crypto-force/web test:e2e",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @crypto-force/api db:generate",
    "db:migrate": "pnpm --filter @crypto-force/api db:migrate",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "6.44.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
