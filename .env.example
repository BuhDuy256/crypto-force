# Copy to .env and adjust. Read by Docker Compose, apps/api and apps/worker.

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=crypto_force
POSTGRES_PASSWORD=crypto_force
POSTGRES_DB=crypto_force
POSTGRES_PORT=5432
DATABASE_URL=postgres://crypto_force:crypto_force@localhost:5432/crypto_force

# apps/api
API_PORT=3000

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the web app (the API is reached through its /api proxy).
BETTER_AUTH_URL=http://localhost:5173

# Email through Resend. Leave both empty in development to print emails to the API console.
RESEND_API_KEY=
EMAIL_FROM=

# Google OAuth (optional). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
