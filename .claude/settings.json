{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-edited-file.mjs",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ui-design-review@rknall-custom-skills": true,
    "auth-skills@better-auth-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "rknall-custom-skills": {
      "source": {
        "source": "github",
        "repo": "rknall/claude-skills",
        "ref": "ca7fbd0e07f824b119030f323da3409bc779f9bc"
      }
    },
    "better-auth-agent-skills": {
      "source": {
        "source": "github",
        "repo": "better-auth/skills",
        "ref": "20c9e88a5c007461a703f1c213572b073196113e"
      }
    }
  }
}
